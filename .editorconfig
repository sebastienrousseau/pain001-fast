# SPDX-License-Identifier: Apache-2.0 OR MIT
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4
# rustfmt's default max_width (rustfmt.toml pins the defaults)
max_line_length = 100

[*.{py,pyi}]
indent_style = space
indent_size = 4
# ruff's line-length in pyproject.toml
max_line_length = 79

[*.{yml,yaml,json,jsonc,cff}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
